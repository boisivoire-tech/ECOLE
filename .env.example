# ==============================================================================
# FICHIER D'EXEMPLE DE CONFIGURATION (.env.example)
# Copiez ce fichier sous le nom ".env" à la racine du projet et remplacez
# les valeurs d'exemple ci-dessous. Ne mettez jamais votre fichier ".env" sur Git.
# ==============================================================================

# 1. Connexion à la base de données PostgreSQL
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE?schema=public
DATABASE_URL="postgresql://postgres:REMPLACER_PAR_VOTRE_MOT_DE_PASSE_POSTGRES@localhost:5432/portail_scolaire?schema=public"

# 2. Clé secrète de signature des sessions (obligatoire, au moins 32 caractères aléatoires)
# Sous Windows 11 (PowerShell), générez une clé aléatoire avec la commande :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_DE_64_CARACTERES_MINIMUM"

# 3. Ports de fonctionnement en développement local
API_PORT=3001
VITE_PORT=5173

# 4. Environnement d'exécution ("development" sur votre PC Windows, "production" en ligne)
NODE_ENV="development"

# 5. Durée de validité d'une session connectée en heures (par défaut : 8 heures)
SESSION_DURATION_HOURS=8
